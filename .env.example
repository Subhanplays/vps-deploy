# ==========================================================================
# VPS Bot v2 - environment / secrets
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Everything here is a secret or an operational path - NOT branding.
# Branding, resources, status, plans and UI text live in bot/config/config.json
# and can be changed at runtime with /settings.
# ==========================================================================

# --- Discord ---------------------------------------------------------------
# The bot token. Keep this private.
DISCORD_TOKEN=

# Optional bootstrap admin user IDs (comma separated). These are merged with
# `access.admin_ids` from config.json at startup. You can manage admins later
# with /settings or /admin.
ADMIN_USER_IDS=
# Optional admin role IDs (comma separated). Merged with access.admin_roles.
ADMIN_ROLE_IDS=

# --- Storage ---------------------------------------------------------------
# SQLite database file (created automatically, schema migrated on boot).
DATABASE_FILE=data/vps.db

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
