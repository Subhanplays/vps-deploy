# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
# Administrator role ID (members with this role are admins) and/or user IDs.
ADMIN_ROLE_ID=
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# White-label branding - change these to turn the bot into your own service.
# ---------------------------------------------------------------------------
BOT_NAME=MyHost
BOT_STATUS=Powered by MyHost
BOT_ACTIVITY_TYPE=Watching      # Playing | Watching | Listening | Streaming | Custom
BOT_FOOTER=MyHost VPS
BOT_AUTHOR=MyHost
BOT_EMOJI=🖥️
BOT_COLOR=#5865F2
BOT_LOGO=
BOT_WEBSITE=https://example.com
BOT_SUPPORT_SERVER=https://discord.gg/example
BOT_STREAM_URL=https://example.com

# ---------------------------------------------------------------------------
# RAM overcommit / overselling (admin controlled)
# The allocation budget that may be exceeded above physical RAM on purpose.
# ---------------------------------------------------------------------------
RAM_OVERCOMMIT=true
MAX_ALLOCATED_RAM=120GB

# ---------------------------------------------------------------------------
# CPU overcommit (admin controlled)
# ---------------------------------------------------------------------------
CPU_OVERCOMMIT=true
MAX_ALLOCATED_CPU=32

# ---------------------------------------------------------------------------
# Per-VPS limits
# ---------------------------------------------------------------------------
MAX_VPS_PER_USER=3
MAX_DISK_PER_VPS=500GB
MAX_RAM_PER_VPS=120GB
MAX_CPU_PER_VPS=16

# ---------------------------------------------------------------------------
# Host paths
# ---------------------------------------------------------------------------
DATA_DIR=/var/lib/vpsbot
STORAGE_DIR=/var/lib/vpsbot/disks
INSTANCES_DIR=/var/lib/vpsbot/instances
KEYS_DIR=/var/lib/vpsbot/keys
IMAGES_DIR=/var/lib/vpsbot/images
DATABASE_FILE=/var/lib/vpsbot/vpsbot.db

UBUNTU_IMAGE=/var/lib/vpsbot/images/ubuntu/ubuntu.qcow2
DEBIAN_IMAGE=/var/lib/vpsbot/images/debian/debian.qcow2

# ---------------------------------------------------------------------------
# Networking / VM defaults
# ---------------------------------------------------------------------------
# Either a libvirt NAT network name (default) or a bridge name (VM_BRIDGE).
NETWORK_NAME=default
VM_BRIDGE=
SSH_USER=root
INITIAL_USER=user
VM_PREFIX=vps
HOSTNAME_PREFIX=vps

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
TMATE_ENABLED=true
DEPLOY_TIMEOUT=600
RATE_LIMIT_SECONDS=60
